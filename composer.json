{
    "name": "jovian/appkit",
    "description": "macOS AppKit Bindings for The PHP AppKit Extension",
    "type": "library",
    "version": "0.8.0",
    "keywords": [
        "framework",
        "venusian",
        "scrapyard-io",
        "appkit",
        "bindings",
        "macos"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/appkit/0.8.x/overview",
    "support": {
        "docs": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/appkit/0.8.x/overview",
        "issues": "https://github.com/jovian/appkit/issues",
        "source": "https://github.com/jovian/appkit"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ext-appkit": "^0.8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "Jovian\\Bindings\\AppKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Tests\\": "tests/",
            "Jovian\\Bindings\\AppKit\\Generator\\": "scripts/Generator/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.8.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "pest"
    }
}
